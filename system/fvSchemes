FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme		HLLCP;

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
	default         cellLimited Gauss linear 0.7;
}

divSchemes
{
    default             Gauss linear;
    div(rhoPhi,Yi_h)    Gauss vanLeer;
}
laplacianSchemes
{
		default			Gauss linear corrected;	
}

interpolationSchemes
{
    default             linear;
    reconstruct(rho)    Minmod;
    reconstruct(rhoU)   MinmodV; 
    reconstruct(rPsi)   Minmod;
    reconstruct(e)      Minmod;
    reconstruct(c)      Minmod;
    reconstruct(Yi)     Minmod;
}  

snGradSchemes
{
		default			corrected;
}


