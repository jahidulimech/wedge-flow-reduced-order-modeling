/*--------------------------------*- C++ -*----------------------------------*\
  reactions.foam — H2/air kinetic mechanism
  
  Mechanism: Li et al. (2004) Int. J. Chem. Kinet. 36:566-575
             19 elementary reactions, 9 species

  Source values: Table I (cm³-mol-sec-kcal-K units)
  SI conversion:
    Bimolecular A : A_paper × 1e-3   [cm³/mol/s  → m³/kmol/s]
    Trimolecular A: A_paper × 1e-6   [cm⁶/mol²/s → m⁶/kmol²/s]
    Ta            : E[kcal/mol] × 503.07  [K]
\*---------------------------------------------------------------------------*/

reactions
{
    // ── R1: H + O2 = O + OH  (chain-branching) ──────────────────────────────
    // Paper: A=3.55e15, n=-0.41, E=16.6  | Ref: Hessler [16]
    // SI:    A=3.55e15×1e-3=3.55e12, Ta=16.6×503.07=8351
    R1
    {
        type        reversibleArrheniusReaction;
        reaction    "H + O2 = O + OH";
        A           3.55e+12;
        beta        -0.41;
        Ta          8351.0;
    }

    // ── R2: O + H2 = H + OH ─────────────────────────────────────────────────
    // Paper: A=5.08e4, n=2.67, E=6.29  | Ref: Sutherland [44]
    // SI:    A=5.08e4×1e-3=5.08e1, Ta=6.29×503.07=3164
    R2
    {
        type        reversibleArrheniusReaction;
        reaction    "O + H2 = H + OH";
        A           5.08e+01;
        beta        2.67;
        Ta          3164.0;
    }

    // ── R3: H2 + OH = H2O + H ───────────────────────────────────────────────
    // Paper: A=2.16e8, n=1.51, E=3.43  | Ref: Michael [45]
    // SI:    A=2.16e8×1e-3=2.16e5, Ta=3.43×503.07=1726
    R3
    {
        type        reversibleArrheniusReaction;
        reaction    "H2 + OH = H2O + H";
        A           2.16e+05;
        beta        1.51;
        Ta          1726.0;
    }

    // ── R4: O + H2O = OH + OH ───────────────────────────────────────────────
    // Paper: A=2.97e6, n=2.02, E=13.4  | Ref: Sutherland [46]
