        Ta          0.0;
    }

    // ── R13: HO2 + OH = H2O + O2 ─────────────────────────────────────────────
    // Paper: A=2.89e13, n=0, E=-0.50  | Ref: Baulch [34]
    // SI:    A=2.89e13×1e-3=2.89e10, Ta=-0.50×503.07=-252
    R13
    {
        type        reversibleArrheniusReaction;
