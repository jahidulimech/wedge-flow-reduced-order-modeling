        A           2.89e+10;
        beta        0.0;
        Ta          -252.0;
    }

    // ── R14a: HO2 + HO2 = H2O2 + O2  (low-T channel) ────────────────────────
    // Paper: A=4.20e14, n=0, E=11.98  | Ref: Hippler [49]
    // SI:    A=4.20e14×1e-3=4.20e11, Ta=11.98×503.07=6027
    R14a
