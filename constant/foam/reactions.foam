    // ── R15: H2O2 + M = OH + OH + M ──────────────────────────────────────────
    // Paper k0: A=1.20e17, n=0, E=45.5  | Ref: Brouwer [51]
    // SI:    A=1.20e17×1e-6=1.20e11, Ta=45.5×503.07=22890
    // Efficiencies: H2=2.5, H2O=12.0, others=1.0
    R15
    {
        type            reversibleArrheniusTroeFallOff;
        reaction        "H2O2 = OH + OH";
        k0
        {
            A               1.20e+14;
            beta            0.00;
            Ta              22889.685;
        }
        kInf
        {
            A               2.95e+14;
            beta            0.00;
            Ta              24348.588;
        }
        F  
        {
            alpha           0.5;
            Tsss            1e-30;
            Ts              1e+30;
            Tss             4.503599627e+15;
        }
        thirdBodyEfficiencies
        {
            coeffs
            (
 		("H2"    2.5)
		("O2"    1.0)
		("H2O"   12.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0) 

            );
