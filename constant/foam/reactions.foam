    R4
    {
        type        reversibleArrheniusReaction;
        reaction    "O + H2O = OH + OH";
        A           2.97e+03;
        beta        2.02;
        Ta          6741.0;
    }

    // ── R5: H2 + M = H + H + M  (3-body dissociation) ──────────────────────
    // Paper: A=4.58e19, n=-1.40, E=104.38  | Ref: Tsang [47]
    // SI:    A=4.58e19×1e-6=4.58e13, Ta=104.38×503.07=52510.44
    // Efficiencies: H2=2.5, H2O=12.0, others=1.0
    R5
    {
        type        reversibleThirdBodyArrheniusReaction;
        reaction    "H2 = H + H ";
        A           4.58e+16;
        beta        -1.40;
        Ta          52510.44;
        coeffs
        (
		("H2"    2.5)
		("O2"    1.0)
		("H2O"   12.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0)            
        );
    }

    // ── R6: O + O + M = O2 + M ──────────────────────────────────────────────
    // Paper: A=6.16e15, n=-0.50, E=0  | Ref: Tsang [47]
    // SI:    A=6.16e15×1e-6=6.16e9, Ta=0
    R6
    {
        type        reversibleThirdBodyArrheniusReaction;
        reaction    "O + O = O2";
        A           6.16e+09;
        beta        -0.50;
        Ta          0.0;
        coeffs
        (
		("H2"    2.5)
		("O2"    1.0)
		("H2O"   12.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0) 
        );
    }

    // ── R7: O + H + M = OH + M ──────────────────────────────────────────────
    // Paper: A=4.71e18, n=-1.0, E=0  | Ref: Tsang [47]
    // SI:    A=4.71e18×1e-6=4.71e12, Ta=0
    R7
    {
        type        reversibleThirdBodyArrheniusReaction;
        reaction    "O + H = OH";
        A           4.71e+12;
        beta        -1.0;
        Ta          0.0;
        coeffs
        (
		("H2"    2.5)
		("O2"    1.0)
		("H2O"   12.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0) 
        );
    }

    // ── R8: H + OH + M = H2O + M ────────────────────────────────────────────
    // Paper: A=3.8e22, n=-2.0, E=0  | Ref: See text
    // SI:    A=3.8e22×1e-6=3.8e16, Ta=0
    // Efficiencies: H2=0.73, H2O=3.65, others=1.0
    R8
    {
        type        reversibleThirdBodyArrheniusReaction;
        reaction    "H + OH = H2O";
        A           3.8e+16;
        beta        -2.0;
        Ta          0.0;
        coeffs
        (
		("H2"    2.5)
		("O2"    1.0)
		("H2O"   12.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0)         );
    }

    // ── R9: H + O2 + M = HO2 + M  (low-pressure limit, M=N2) ───────────────
    // Paper k0: A=6.37e20, n=-1.72, E=0.52  | Ref: Michael [19]
    // SI:    A=6.37e20×1e-6=6.37e14, Ta=0.52×503.07=262
    // Efficiencies: H2=1.3, H2O=14.0, O2=0.78, others=1.0
    R9
    {
        type            reversibleArrheniusTroeFallOff;
        reaction        "H + O2 = HO2";
        k0
        {
            A               6.37e+14;
            beta            -1.72;
            Ta              261.5964;
        }
        kInf
        {
            A               1.48e+09;
            beta            0.60;
            Ta              0.0;
        }
        F  // টিউটোরিয়ালের মতো F ব্লক যোগ করলেন
        {
            alpha           0.8;
            Tsss            1e-30;
            Ts              1e+30;
            Tss             4.503599627e+15;
        }
        thirdBodyEfficiencies
        {
            coeffs
            (
		("H2"    2.5)
		("O2"    1.0)
		("H2O"   11.0)
		("H"     1.0)
		("O"     1.0)
		("OH"    1.0)
		("HO2"   1.0)
		("H2O2"  1.0)
		("N2"    1.0)             );
        }
    }

